# ── Notion MCP mode (preferred) ──────────────────────────────────────
# Use the Notion MCP server for data access.
# Option A — Hosted (OAuth, no token needed):
#   NOTION_MCP_URL=https://mcp.notion.com/mcp
# Option B — Local (npx @notionhq/notion-mcp-server with --transport http):
#   NOTION_MCP_URL=http://localhost:3100/mcp
NOTION_MCP_URL=

# Database ID is required for both MCP and Direct API modes
NOTION_DATABASE_ID=your_notion_database_id_here

# ── Direct API mode (fallback) ──────────────────────────────────────
# Only used when NOTION_MCP_URL is not set.
# Create an integration at https://www.notion.so/my-integrations
NOTION_API_KEY=your_notion_integration_secret_here
